pipeline {
    agent any

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Python') {
            steps {
                bat '"C:\\Users\\kripa\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" --version'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat '"C:\\Users\\kripa\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                bat '"C:\\Users\\kripa\\AppData\\Local\\Programs\\Python\\Python313\\python.exe" -m pytest'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat '"C:\\Users\\kripa\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" build -t hospital-appointment:latest .'
            }
        }

        stage('Run Docker Container') {
            steps {
                bat '"C:\\Users\\kripa\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" stop hospital-appointment || exit /b 0'
                bat '"C:\\Users\\kripa\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" rm hospital-appointment || exit /b 0'
                bat '"C:\\Users\\kripa\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe" run -d -p 5000:5000 --name hospital-appointment hospital-appointment:latest'
            }
        }
    }

    post {
        success {
            echo 'Hospital Appointment project built and deployed successfully!'
        }

        failure {
            echo 'Build or deployment failed. Check the console output.'
        }
    }
}