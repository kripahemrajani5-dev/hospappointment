pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Check Python') {
            steps {
                bat 'python --version'
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'python -m pip install -r requirements.txt'
            }
        }

        stage('Run Tests') {
            steps {
                bat 'pytest'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat 'docker build -t hospital-appointment:latest .'
            }
        }
    }

    post {
        success {
            echo 'Hospital Appointment project built successfully!'
        }

        failure {
            echo 'Build failed. Check the console output.'
        }
    }
}